# === LOCAL DEV ONLY (.env.local) ============================================
#
# Firebase setup (simple): docs/FIREBASE_SETUP.md
#
# --- Firebase Auth (Google sign-in — any Google user can play) ---------------
# Admins: @criminallydevdads.com OR emails in cms/admin-config.json
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# --- Game catalog (default: legacy = always use games.json + games/ folder) ---
# VITE_GAME_CATALOG=legacy

# --- GitHub repo (for game folder discovery + admin GitHub sync) --------------
# Publishing playbook: docs/HOW_TO_UPDATE.md
VITE_GITHUB_REPO_OWNER=CDDdrifter
VITE_GITHUB_REPO_NAME=criminallydevdads.com

# --- Optional -----------------------------------------------------------------
# VITE_SHOW_ADMIN_NAV=true
# VITE_AUTH_REDIRECT_URL=https://criminallydevdads.com/

# --- Legacy Supabase (optional — only if you still have an active project) ----
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key
